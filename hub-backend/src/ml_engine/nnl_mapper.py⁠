import numpy as np

class AdvancedNNLMapper:
    """
    Maps multi-channel EEG frequency band ratios into high-level cognitive 
    intents to trigger hands-free eyewear actions.
    """
    @staticmethod
    def classify_intent(alpha: float, beta: float, gamma: float, theta: float) -> str:
        total_power = alpha + beta + gamma + theta + 1e-6
        
        # Normalized ratios
        beta_ratio = beta / total_power
        gamma_ratio = gamma / total_power
        
        if gamma_ratio > 0.35:
            return "TRIGGER_VISION_ANALYSIS"
        elif beta_ratio > 0.40:
            return "TRIGGER_DEEP_FOCUS_MODE"
        elif alpha / (theta + 1e-6) > 2.0:
            return "TRIGGER_RELAXATION_AUDIO"
        else:
            return "STANDBY_STATE"
